import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import '@testing-library/jest-dom';
import { AddItemModal } from '../../src/components/AddItemModal';
import { createMockCollections } from '../utils/fixtures/collections';
import { vi } from 'vitest';
import { Camera, CameraSource } from '@capacitor/camera';
import { renderWithProviders } from '../utils/test-utils';

// Correctly mock the @capacitor/camera module, including enums
vi.mock('@capacitor/camera', async () => {
  const original = await vi.importActual('@capacitor/camera');
  return {
    ...original,
    Camera: {
      getPhoto: vi.fn(),
    },
  };
});

describe.skip('AddItemModal', () => {
  const collections = createMockCollections(2);
  const defaultProps = {
    isOpen: true,
    onClose: vi.fn(),
    collections: [collections[0]],
    onSave: vi.fn(),
  };

  beforeEach(() => {
    vi.clearAllMocks();
    (Camera.getPhoto as vi.Mock).mockClear();
  });

  it('renders the modal when it is open', () => {
    renderWithProviders(<AddItemModal {...defaultProps} />);
    expect(screen.getByRole('dialog')).toBeInTheDocument();
  });

  it('calls Camera.getPhoto with the correct source when "Take Photo" is clicked', async () => {
    (Camera.getPhoto as vi.Mock).mockResolvedValue({ dataUrl: 'data:image/jpeg;base64,' });
    renderWithProviders(<AddItemModal {...defaultProps} />);

    const takePhotoButton = await screen.findByRole('button', { name: /take photo/i });
    fireEvent.click(takePhotoButton);

    await waitFor(() => {
      expect(Camera.getPhoto).toHaveBeenCalledWith(
        expect.objectContaining({
          source: CameraSource.Camera,
        })
      );
    });
  });

  it('calls onSave with the correct data when form is submitted manually', async () => {
    renderWithProviders(<AddItemModal {...defaultProps} />);

    const skipButton = await screen.findByText(/skip/i);
    fireEvent.click(skipButton);

    const titleInput = await screen.findByLabelText(/title/i);
    fireEvent.change(titleInput, { target: { value: 'Test Title' } });

    const saveButton = await screen.findByRole('button', { name: /add to collection/i });
    fireEvent.click(saveButton);

    await waitFor(() => {
      expect(defaultProps.onSave).toHaveBeenCalledWith(
        defaultProps.collections[0].id,
        expect.objectContaining({
          title: 'Test Title',
        })
      );
    });
  });
});
