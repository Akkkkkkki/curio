# =============================================================================
# Curio Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel/production, set these in your project's Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_public_key

# Enable timestamp-based merge strategy for sync conflict resolution
VITE_SUPABASE_SYNC_TIMESTAMPS=true

# -----------------------------------------------------------------------------
# Local Storage Quota Warning (Optional)
# -----------------------------------------------------------------------------
# Warn when remaining storage drops below either threshold.
VITE_STORAGE_QUOTA_WARNING_THRESHOLD_BYTES=52428800
VITE_STORAGE_QUOTA_WARNING_THRESHOLD_RATIO=0.1
VITE_STORAGE_QUOTA_CHECK_INTERVAL_MS=600000

# -----------------------------------------------------------------------------
# AI Gateway Security (Required for Production)
# -----------------------------------------------------------------------------
# JWT secret for verifying Supabase auth tokens
# Get this from: Supabase Dashboard > Settings > API > JWT Secret
# Required in production; optional in development (auth skipped if not set)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# CORS allowed origins (comma-separated)
# Required in production; optional in development (defaults to allow all)
# Example: https://curio.example.com,https://staging.curio.example.com
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# AI Features - Gemini API
# -----------------------------------------------------------------------------
# Server-side only (Gemini proxy) - NEVER expose this to the client
# Set this in Vercel as a non-VITE_ prefixed variable, or in .env.local for local dev
GEMINI_API_KEY=your_gemini_api_key

# Gemini model for metadata extraction (vision/text analysis)
# Default: gemini-2.5-flash
GEMINI_ANALYZE_MODEL=gemini-2.5-flash

# Gemini model for image generation/enhancement
# Default: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# API base URL for the Gemini proxy
# Local dev: http://localhost:8787
# Production: leave empty (uses same-origin /api/* rewrites) or set to your proxy URL
VITE_API_BASE_URL=http://localhost:8787

# Enable/disable AI features (set to 'true' to enable)
# All AI features are enabled by default when GEMINI_API_KEY is configured
VITE_AI_ENABLED=true

# AI Metadata Extraction (image → structured fields)
# Enables AI-powered field extraction when adding items
VITE_AI_METADATA_ENABLED=true

# AI Image Enhancement (image → enhanced image)
# Enables "Enhance Image" button on item detail screen
VITE_AI_IMAGE_EDIT_ENABLED=true

# Voice Guide (Museum Guide audio feature)
# Disabled by default - requires additional setup
VITE_VOICE_GUIDE_ENABLED=false

# -----------------------------------------------------------------------------
# Vercel/Production Notes
# -----------------------------------------------------------------------------
# In Vercel, set:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
#   - VITE_SUPABASE_SYNC_TIMESTAMPS=true
#   - GEMINI_API_KEY (for the serverless function / proxy)
#   - GEMINI_ANALYZE_MODEL (optional)
#   - GEMINI_IMAGE_MODEL (optional)
#
# AI Gateway Security (REQUIRED for production):
#   - SUPABASE_JWT_SECRET (from Supabase Dashboard > Settings > API > JWT Secret)
#   - CORS_ORIGINS (e.g., https://your-app.vercel.app)
#   - NODE_ENV=production (set automatically by Vercel)
#
# AI feature flags (all enabled by default):
#   - VITE_AI_ENABLED=true
#   - VITE_AI_METADATA_ENABLED=true
#   - VITE_AI_IMAGE_EDIT_ENABLED=true
#
# Do NOT set VITE_API_BASE_URL in production - the vercel.json rewrites handle routing.
#
# GitHub Actions / CI:
#   - Set the same variables as secrets if needed for E2E tests
