# =============================================================================
# Curio Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel/production, set these in your project's Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_public_key

# Enable timestamp-based merge strategy for sync conflict resolution
VITE_SUPABASE_SYNC_TIMESTAMPS=true

# -----------------------------------------------------------------------------
# AI Features - Gemini API
# -----------------------------------------------------------------------------
# Server-side only (Gemini proxy) - NEVER expose this to the client
# Set this in Vercel as a non-VITE_ prefixed variable, or in .env.local for local dev
GEMINI_API_KEY=your_gemini_api_key

# API base URL for the Gemini proxy
# Local dev: http://localhost:8787
# Production: leave empty (uses same-origin /api/* rewrites) or set to your proxy URL
VITE_API_BASE_URL=http://localhost:8787

# Enable/disable AI features (set to 'true' to enable)
# If not set, checks server health endpoint to determine availability
VITE_AI_ENABLED=true

# AI Metadata Extraction (image → structured fields)
# Enables AI-powered field extraction when adding items
VITE_AI_METADATA_ENABLED=true

# AI Image Enhancement (image → enhanced image)
# Enables "Enhance Image" button on item detail screen
# Set to 'true' to enable, 'false' to disable
VITE_AI_IMAGE_EDIT_ENABLED=false

# Voice Guide (Museum Guide audio feature)
# Disabled by default - requires additional setup
VITE_VOICE_GUIDE_ENABLED=false

# -----------------------------------------------------------------------------
# Vercel/Production Notes
# -----------------------------------------------------------------------------
# In Vercel, set:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
#   - VITE_SUPABASE_SYNC_TIMESTAMPS=true
#   - VITE_AI_ENABLED=true (or omit to auto-detect)
#   - VITE_AI_METADATA_ENABLED=true
#   - VITE_AI_IMAGE_EDIT_ENABLED=true (if you want image enhancement)
#   - GEMINI_API_KEY (for the serverless function / proxy)
#
# Do NOT set VITE_API_BASE_URL in production - the vercel.json rewrites handle routing.
#
# GitHub Actions / CI:
#   - Set the same variables as secrets if needed for E2E tests
